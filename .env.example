# GEMINI_API_KEY (Opsional) - Diisi jika ingin mengaktifkan fitur AI Generatif (Gemini)
GEMINI_API_KEY=


# Mode penyimpanan: online = Cloud SQL + Cloudinary, offline = PostgreSQL/local_store.json + uploads/.
# Jika kosong: Cloud Run otomatis online, localhost otomatis offline.
# PENTING: APP_MODE tidak pernah mengaktifkan akun BOSS atau generator token.
APP_MODE=

# JWT_SECRET (Required) - Server-Side JWT Secret key for user sessions
JWT_SECRET=

# HTTPS lokal OFFLINE untuk kamera/WebRTC melalui IP LAN.
# HANYA berlaku saat storage mode OFFLINE; Cloud Run/online mengabaikan pengaturan ini.
# true = server lokal menggunakan HTTPS pada PORT yang sama (default 3000).
USE_HTTPS=false
# Opsional: pakai sertifikat TLS milik sendiri. Harus diisi berpasangan.
# Cocok untuk domain LAN/split-DNS dengan sertifikat yang sudah dipercaya perangkat.
OFFLINE_HTTPS_KEY_PATH=
OFFLINE_HTTPS_CERT_PATH=
# Opsional untuk sertifikat self-signed otomatis: DNS/SAN tambahan dipisahkan koma.
# Contoh: cbt.sekolah.local,cbt.sekolah.lan
OFFLINE_HTTPS_HOSTNAMES=

# Kredensial Super Admin / BOS Platform
# BOSS hanya aktif pada runtime Cloud Run yang terdeteksi oleh marker platform (K_SERVICE + K_REVISION/K_CONFIGURATION)
# serta ketika BOSS_USERNAME, BOSS_PASSWORD, LICENSE_PRIVATE_KEY, dan LICENSE_PUBLIC_KEY tersedia.
# APP_MODE / IS_CLOUD_SERVER / hostname tidak dapat mengaktifkan BOSS pada localhost.
BOSS_USERNAME=
BOSS_PASSWORD=

# Kunci enkripsi local_store. Wajib pada mode online.
# Offline: jika kosong, aplikasi membuat secret acak di .madrasah-secrets/ (tidak masuk Git).
LOCAL_STORE_SECRET=
# Hanya untuk migrasi satu kali instalasi lama; jangan commit nilainya dan hapus setelah migrasi berhasil.
LOCAL_STORE_LEGACY_SECRET=

# Kunci penguncian token. Wajib pada mode online.
# Offline: jika kosong, aplikasi membuat secret acak di .madrasah-secrets/ (tidak masuk Git).
TOKEN_LOCK_SECRET=
# Hanya untuk migrasi satu kali signature token lama; jangan commit nilainya dan hapus setelah migrasi berhasil.
TOKEN_LOCK_LEGACY_SECRET=

# Kunci Aktivasi Token Asimetris
# LICENSE_PRIVATE_KEY hanya boleh ada di server BOSS online. JANGAN salin ke instalasi madrasah.
# LICENSE_PUBLIC_KEY harus sama di BOSS dan instalasi admin offline; public key aman didistribusikan.
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# Pemulihan satu kali foto Firestore legacy (opsional).
# Normalnya kosong: server membaca projectId/firestoreDatabaseId dari firebase-applet-config.json.
# Hanya isi bila konfigurasi legacy perlu dioverride. Firestore tetap NONAKTIF untuk persistence normal.
LEGACY_FIRESTORE_PROJECT_ID=
LEGACY_FIRESTORE_DATABASE_ID=

# Cloudinary (Untuk backup foto)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Keamanan origin untuk mode online (pisahkan dengan koma). Kosong = hanya same-origin.
ALLOWED_ORIGINS=
# Opsional: sumber iframe yang diizinkan. Default online: 'self'.
ALLOWED_FRAME_ANCESTORS=
# Masa berlaku sesi JWT dalam detik. Default: online 12 jam, offline 30 hari.
JWT_TTL_SECONDS=

# Cloud SQL PostgreSQL.
# ONLINE/Cloud Run: hanya Cloud SQL yang digunakan. Jangan gunakan DATABASE_URL/Neon.
# SQL_HOST boleh diisi Unix socket /cloudsql/PROJECT:REGION:INSTANCE, tetapi bila
# Cloud Run sudah memasang tepat satu socket Cloud SQL, server dapat mendeteksinya otomatis.
# Jika lebih dari satu instance dipasang, SQL_HOST atau CLOUD_SQL_CONNECTION_NAME wajib
# diisi agar deployment tidak pernah memilih database yang salah.
# Credential menerima SQL_USER/SQL_PASSWORD; alias PGUSER/PGPASSWORD dan
# SQL_ADMIN_USER/SQL_ADMIN_PASSWORD tetap kompatibel dengan deployment lama.
# Runtime dan Drizzle memakai resolver SQL yang sama, termasuk alias dan port.
# SQL_DB_NAME opsional; default produksi: cloud_sql_production_database.
# OFFLINE: localhost PostgreSQL/local_store.json tetap didukung.
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_PORT=5432
CLOUD_SQL_CONNECTION_NAME=

# Hanya untuk migrasi kode aktivasi HMAC lama di mode offline. Default/produksi: false.
ALLOW_LEGACY_HMAC_ACTIVATION=false
