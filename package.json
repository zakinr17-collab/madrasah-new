{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/prepare-build.js && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "db:push": "npx drizzle-kit push --config=drizzle.config.ts",
    "clean": "node scripts/clean.js",
    "lint": "tsc --noEmit",
    "security:audit": "node scripts/security-audit.cjs",
    "hardening:regression": "node --import tsx scripts/hardening-regression.ts",
    "runtime:regression": "node --import tsx scripts/runtime-regression.ts",
    "runtime:smoke": "node scripts/runtime-smoke.cjs",
    "frontend:handler-audit": "node scripts/check-inline-handler-globals.mjs",
    "font:asset-audit": "node scripts/font-asset-audit.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "selfsigned": "^5.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "esbuild": "$esbuild",
    "qs": "6.16.0",
    "@xmldom/xmldom": "^0.9.9",
    "nanoid": "^3.3.19"
  }
}
